# Copy this file to .env later. Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=180

# These are placeholders for a financial-data provider chosen in a later phase.
FINANCIAL_DATA_API_KEY=

# SEC asks automated clients to identify themselves. Replace the example contact.
SEC_USER_AGENT=Personal Investment Assistant your-email@example.com

# Stored single-company dashboard (private US operating-company pilot).
COMPANY_TICKER=NVDA
COMPANY_NAME=NVIDIA
COMPANY_CIK=0001045810
COMPANY_EXCHANGE=NASDAQ
COMPANY_MARKET=SPY
COMPANY_SECTOR=XLK
TWELVE_DATA_API_KEY=
FRED_API_KEY=
# Describe your reviewed provider storage/display/modelling and FRED series permissions.
# Ingestion is disabled until this record and the corresponding keys are supplied.
COMPANY_DATA_USAGE_RECORD=
# Describe split AND dividend checks against known corporate actions for all symbols.
# Without this record, returns are provisional and forecast evaluation is disabled.
COMPANY_ADJUSTMENT_RECORD=
# Enable only when raw-response retention is permitted; hashes/metadata are always saved.
COMPANY_RETAIN_RAW=false
### Durable multi-company worker budgets (UTC day; set only from reviewed account limits).
# Zero keeps queued ingestion waiting without vendor requests. Legacy ingest keeps its existing cap.
COMPANY_TWELVE_DAILY_CREDITS=0
COMPANY_SEC_DAILY_CREDITS=0
COMPANY_FRED_DAILY_CREDITS=0
